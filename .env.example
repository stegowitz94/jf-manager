# JF-Manager 1.0 – keine Passwörter in dieser Datei.
# Geheimnisse werden durch ./setup.sh in ./secrets/ erzeugt bzw. aus einer alten .env migriert.

# Netzwerk / Django
# Die eine öffentliche URL steuert Allowed Hosts, CSRF und Secure Cookies automatisch.
# Beispiele:
#   Lokal:       JF_PUBLIC_URL=http://192.168.1.50:8000
#   Cloudflare:  JF_PUBLIC_URL=https://jfmanager.example.de
JF_PUBLIC_URL=http://localhost:8000
# none | cloudflare | reverse-proxy
JF_PROXY_MODE=none
# URL zum Quellcode dieser bereitgestellten Version (bei AGPL-Netzwerkbetrieb empfohlen)
JF_SOURCE_CODE_URL=
DJANGO_DEBUG=false
DJANGO_TIME_ZONE=Europe/Berlin
DJANGO_DATA_UPLOAD_MAX_NUMBER_FIELDS=20000
# Experten-Overrides (normalerweise leer lassen)
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=jf_manager
POSTGRES_USER=jf_manager
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Mail – Passwort liegt in secrets/smtp_password.txt
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Jugendfeuerwehr <jugendfeuerwehr@example.org>

# Web Push – privater VAPID-Key liegt in secrets/vapid_private_key.txt
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_CLAIMS_EMAIL=mailto:admin@example.org

# Backup-Funktion
BACKUP_STORAGE_DIR=/app/backups
BACKUP_TEMP_DIR=/tmp/jf-manager-backups
BACKUP_MAX_UPLOAD_SIZE=2147483648
BACKUP_SAFETY_KEEP=5

# Kommagetrennte Empfänger für Unfallmeldungen an die Wehrführung
INCIDENT_COMMAND_EMAILS=

# Production security (HSTS erst aktivieren, wenn HTTPS zuverlässig erkannt wird)
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
